# Stripe (leave empty until configured — checkout stub returns a clear message when unset)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional: forward waitlist signups to an external webhook (Zapier, Loops, etc.)
# When unset, /api/waitlist accepts the email and returns 200 with a friendly message.
WAITLIST_WEBHOOK_URL=

# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
